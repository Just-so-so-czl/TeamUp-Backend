# 本地或云端的敏感凭据。所有配置均由 application.yaml 读取，可用同名环境变量覆盖。
SPRING_DATASOURCE_USERNAME=replace_me
SPRING_DATASOURCE_PASSWORD=replace_me
SPRING_RABBITMQ_USERNAME=replace_me
SPRING_RABBITMQ_PASSWORD=replace_me

ALIYUN_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
ALIYUN_OSS_ACCESS_KEY_ID=replace_me
ALIYUN_OSS_ACCESS_KEY_SECRET=replace_me
ALIYUN_OSS_BUCKET_NAME=replace_me

JWT_SECRET=replace-with-a-random-32-byte-or-longer-secret
JWT_ISSUER=teamup-backend

MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_PROTOCOL=smtps
MAIL_USERNAME=replace_me
MAIL_PASSWORD=replace_me

SPRING_AI_OPENAI_BASE_URL=https://api.openai.com
SPRING_AI_OPENAI_API_KEY=replace_me
SPRING_AI_OPENAI_CHAT_MODEL=gpt-4o-mini
SPRING_AI_OPENAI_SUMMARY_MODEL=Qwen3-32B

# 部署环境按需提供以下变量覆盖默认本地连接：
# SPRING_DATASOURCE_URL、SPRING_DATA_REDIS_HOST、SPRING_DATA_REDIS_PASSWORD、
# SPRING_DATA_MONGODB_URI、SPRING_RABBITMQ_HOST、APP_CORS_ALLOWED_ORIGINS、
# COLLABORATION_AGENT_INTERNAL_URL，以及下面三组令牌。

# Docker Compose 部署：MySQL、Redis、RabbitMQ 容器初始化变量。
# MYSQL_USER / MYSQL_PASSWORD 必须分别与 SPRING_DATASOURCE_USERNAME / PASSWORD 相同。
MYSQL_DATABASE=TeamUp
MYSQL_USER=replace_me
MYSQL_PASSWORD=replace_me
MYSQL_ROOT_PASSWORD=replace-with-a-different-random-root-password
REDIS_PASSWORD=replace_me
RABBITMQ_DEFAULT_USER=replace_me
RABBITMQ_DEFAULT_PASS=replace_me

# Docker Compose 部署：后端连接 Docker 内网服务。
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/TeamUp?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PASSWORD=replace_me
SPRING_DATA_MONGODB_URI=mongodb://replace_me:replace_me@mongodb:27017/teamup?authSource=admin
SPRING_RABBITMQ_HOST=rabbitmq
APP_CORS_ALLOWED_ORIGINS=http://your-server-public-ip
COLLABORATION_AGENT_INTERNAL_URL=http://collaboration:1235
COLLABORATION_SUMMARY_INTERNAL_TOKEN=replace-with-a-random-summary-token
COLLABORATION_AGENT_INTERNAL_TOKEN=replace-with-a-random-agent-token
COLLABORATION_ACCESS_INTERNAL_TOKEN=replace-with-a-random-access-token
